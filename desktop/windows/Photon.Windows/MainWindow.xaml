<Window x:Class="Photon.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="Photon · Windows Beta" Width="1200" Height="800" MinWidth="850" MinHeight="580" Background="#100E18" Foreground="White" Closing="WindowClosing">
<Grid x:Name="RootPanel" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid x:Name="HeaderPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,16"><TextBlock Text="Photon" FontSize="32" FontWeight="Bold" Foreground="#BCA5FF"/><TextBlock Text="WINDOWS · 0.2 BETA" FontSize="10" Foreground="#ACA5BF"/></StackPanel><TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,8,6,16" ToolTip="Search or paste a YouTube video, playlist or channel link" KeyDown="SearchKeyDown"/><Button Grid.Column="2" Content="Search" Click="SearchClick" Margin="4,8,0,16"/></Grid>
<Border x:Name="NoticePanel" Grid.Row="1" Background="#231D34" CornerRadius="10" Padding="12" Margin="0,0,0,16"><TextBlock Text="Public YouTube · source multichannel audio + separate-track HD. Google account sync, casting and headset VR remain unported." Foreground="#C1B8D2" TextWrapping="Wrap"/></Border>
<Grid x:Name="BrowserGrid" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
<ListBox x:Name="Results" Background="Transparent" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ResultSelected"><ListBox.ItemTemplate><DataTemplate><Border Background="#211C2F" CornerRadius="10" Padding="12" Margin="0,4,4,8"><StackPanel><Image Source="{Binding Thumbnail}" Height="145" Stretch="UniformToFill"/><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,4"/><TextBlock Text="{Binding Channel}" Foreground="#AFA5BF" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="Black" CornerRadius="10"><vlc:VideoView x:Name="Video"/></Border>
<TextBlock x:Name="VideoTitle" Grid.Row="1" Text="Your world, refracted." TextWrapping="Wrap" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,10"/>
<Slider x:Name="Timeline" Grid.Row="2" Minimum="0" Maximum="1000" PreviewMouseLeftButtonDown="SeekStart" PreviewMouseLeftButtonUp="SeekEnd" Margin="4,8" ToolTip="Seek"/>
<StackPanel Grid.Row="3"><TextBlock x:Name="AudioStatus" Text="Source audio channels appear here. Receiver output is not yet verified." TextWrapping="Wrap" Foreground="#BCA5FF" Margin="4,8"/><WrapPanel><ComboBox x:Name="Audio" DisplayMemberPath="Label" MaxWidth="480" SelectionChanged="AudioChanged" ToolTip="Source soundtrack"/><ComboBox x:Name="Captions" DisplayMemberPath="Label" MaxWidth="180" SelectionChanged="CaptionChanged" ToolTip="Caption language"/><Button Content="5.1 test" Click="Surround6Click"/><Button Content="7.1 test" Click="Surround8Click"/><Button Content="Windows Sound" Click="SoundSettingsClick"/></WrapPanel></StackPanel>
<WrapPanel Grid.Row="4"><Button Content="Play / pause" Click="PlayPause"/><Button Content="−10s" Click="SeekBack"/><Button Content="+10s" Click="SeekForward"/><ComboBox x:Name="Quality" DisplayMemberPath="Label" SelectionChanged="QualityChanged" ToolTip="Source quality"/><ComboBox x:Name="Speed" SelectionChanged="SpeedChanged" ToolTip="Playback speed"/><Slider x:Name="Volume" Width="85" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" ToolTip="Volume" VerticalAlignment="Center" Margin="8"/><Button Content="Full screen" Click="FullscreenClick"/><Button Content="Retry" Click="RetryClick"/><Button Content="Download" Click="DownloadClick"/></WrapPanel>
</Grid></Grid>
<DockPanel x:Name="FooterPanel" Grid.Row="3" Margin="0,14,0,0"><Button x:Name="UpdateButton" DockPanel.Dock="Right" Visibility="Collapsed" Click="UpdateClick" ToolTip="Open the official Windows release"/><Button x:Name="MoreButton" DockPanel.Dock="Right" Content="Load more" IsEnabled="False" Click="MoreClick"/><Button DockPanel.Dock="Right" Content="Cancel" Click="CancelClick"/><TextBlock x:Name="Status" Text="Search to begin. Your Google account has not been connected." Foreground="#B3A8C7" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
</Grid></Window>
